# Genie-SaS backend environment variable template.
#
# Copy this file to `backend/.env` and fill in real values for your own
# development environment. NEVER commit a populated `.env` file - it is
# already excluded by the repository's .gitignore (`.env`, `.env.*`).
#
# Every value below is a placeholder. No tenant ID, client ID, secret,
# subscription ID, or endpoint here is real.
#
# All variables are prefixed GENIE_ and documented in full in the root
# README.md "Configuration reference" section and
# docs/architecture/genie-sas-microsoft-iq.md.

# --- Core service identity ---------------------------------------------------
GENIE_SERVICE_NAME=genie-backend
GENIE_ENVIRONMENT=development
GENIE_LOG_LEVEL=INFO

# --- Execution safety ---------------------------------------------------------
# Genie has no local or mock agent execution mode - these must remain false.
GENIE_ALLOW_MOCK_AGENTS=false
GENIE_ALLOW_LOCAL_AGENTS=false
GENIE_USE_SYNTHETIC_DATA=false
GENIE_GOVERNANCE_PROVIDER=local

# --- Azure AI Foundry (required for all agent execution, including Genie's
# other existing features - not specific to this IQ validation task) --------
GENIE_AZURE_FOUNDRY_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
GENIE_AZURE_FOUNDRY_PROJECT_NAME=<your-foundry-project-name>
# Only required when the Foundry account lives in a different resource
# group than GENIE_DEPLOYMENT_RESOURCE_GROUP (e.g. a dedicated environment
# that intentionally reuses an existing, already-registered Foundry
# project). Leave unset when they're the same resource group.
GENIE_AZURE_FOUNDRY_RESOURCE_GROUP=<resource-group-containing-the-foundry-account>

# --- Storage (in_memory is fine for this validation; see README for the
# durable Cosmos DB configuration required in a shared/hosted environment) --
GENIE_MEMORY_STORE_BACKEND=in_memory
GENIE_LINEAGE_STORE_BACKEND=in_memory

# --- CORS (only needed if the frontend runs on a different origin) ----------
GENIE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================================
# Microsoft Connect / Work IQ (delegated Microsoft Entra ID OAuth)
# See docs/setup/genie-sas-entra-development.md for the exact app-registration
# checklist these values correspond to, and
# docs/architecture/genie-sas-microsoft-iq.md for the full architecture.
# ==============================================================================

# --- Feature flags - all IQ capabilities are disabled by default -------------
# Enable ONLY Work IQ for this validation; leave the rest disabled unless you
# are specifically validating shared delegated-auth infrastructure.
GENIE_WORK_IQ_ENABLED=true
GENIE_FABRIC_IQ_ENABLED=false
GENIE_FOUNDRY_MCP_ENABLED=false
GENIE_FOUNDRY_IQ_ENABLED=false

# --- Work IQ MCP provider -----------------------------------------------------
# Microsoft's documented endpoint - safe to use as-is, it is not a secret.
GENIE_WORK_IQ_MCP_ENDPOINT=https://workiq.svc.cloud.microsoft/mcp
# The exact Work IQ MCP tool to invoke for retrieval. Confirm this against a
# live tools/list response (see app/iq/iq_diagnostics_service.py) rather than
# assuming - Work IQ's tool surface is documented as 10 generic tools
# (fetch/create_entity/update_entity/delete_entity/do_action/call_function/
# ask/list_agents/get_schema/search_paths); "ask" is the natural-language
# Copilot-backed tool most likely to answer a free-text query like the one
# this validation action sends.
GENIE_WORK_IQ_RETRIEVE_TOOL=ask
GENIE_WORK_IQ_QUERY_ARGUMENT=query
# Optional override - defaults to the confirmed documented scope
# "api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask" when left unset.
# GENIE_WORK_IQ_SCOPES=api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask

# --- Delegated Microsoft Entra OAuth client (shared by Work IQ / Fabric IQ) --
# See docs/setup/genie-sas-entra-development.md for exactly what to register.
GENIE_IQ_OAUTH_TENANT_ID=<development-tenant-id>
GENIE_IQ_OAUTH_CLIENT_ID=<development-client-id>
# Names the environment variable that holds the actual secret VALUE - set
# that separately-named variable (e.g. in your secret store), never here.
GENIE_IQ_OAUTH_CLIENT_SECRET_ENV_VAR=GENIE_IQ_OAUTH_CLIENT_SECRET
# GENIE_IQ_OAUTH_CLIENT_SECRET=<development-secret-from-secure-store>
GENIE_IQ_OAUTH_REDIRECT_URI=http://localhost:8000/iq/connections/callback
GENIE_IQ_OAUTH_STATE_TTL_SECONDS=600

# Must be explicitly true, in addition to full OAuth configuration above,
# before a delegated IQ provider may be enabled with GENIE_ENVIRONMENT=production.
GENIE_IQ_DELEGATED_OAUTH_ALLOWED_IN_PRODUCTION=false

# --- First-party platform authentication (app.security.auth_service) -------
# Disabled by default - local dev/test keep the single deterministic
# "genie-internal-user" identity with no login screen at all. Required
# (and fail-closed-enforced by ProductionSafetyValidator) when
# GENIE_ENVIRONMENT=production, since the platform APIM gateway is
# publicly reachable - see README.md "Authentication".
GENIE_AUTH_ENABLED=false
# Names of the environment variables holding the actual secret VALUES -
# set those separately-named variables (e.g. in your secret store), never
# here. Generate a signing key with `openssl rand -base64 48` (at least 32
# bytes). See app.security.password_hashing.hash_password for generating
# each "username:encoded_hash" line of GENIE_AUTH_USERS.
GENIE_AUTH_TOKEN_SIGNING_KEY_ENV_VAR=GENIE_AUTH_TOKEN_SIGNING_KEY
# GENIE_AUTH_TOKEN_SIGNING_KEY=<development-signing-key-from-secure-store>
GENIE_AUTH_USERS_ENV_VAR=GENIE_AUTH_USERS
# GENIE_AUTH_USERS=<username>:<pbkdf2_sha256$iterations$salt_hex$hash_hex>
GENIE_AUTH_TOKEN_TTL_SECONDS=3600

# Fabric IQ (only if GENIE_FABRIC_IQ_ENABLED=true): the required Power BI
# Service API permissions are documented (Item.Read.All, Item.Execute.All,
# Dataset.Read.All), but the exact scope strings depend on how your app
# registration exposes them - confirm against your own registration, do not
# guess a value.
# GENIE_FABRIC_IQ_MCP_ENDPOINT=https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq
# GENIE_FABRIC_IQ_RETRIEVE_TOOL=<confirmed-via-tools/list>
# GENIE_FABRIC_IQ_SCOPES=<space-separated scopes from your app registration>
